# Base de datos PostgreSQL
POSTGRES_USER=surtigas
POSTGRES_PASSWORD=surtigas_dev_password
POSTGRES_DB=surtigas_turnos
DATABASE_URL=postgresql+psycopg://surtigas:surtigas_dev_password@localhost:5432/surtigas_turnos

# Seguridad y Autenticación (Ley 1581 de 2012)
JWT_SECRET_KEY=cambia-esta-clave-secreta-en-produccion-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_REQUIRED=false
AUTH_DEMO_ROLE_SWITCH=true

# CORS y Frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
VITE_API_BASE_URL=http://localhost:8000

# Motor Digiturno y Tiempo Real
DIGITURNO_SOURCE_MODE=mock
REALTIME_INTERVAL_SECONDS=5
SEED_ON_STARTUP=true
